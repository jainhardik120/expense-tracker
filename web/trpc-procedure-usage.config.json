{
  "backendRouterEntry": "src/server/routers/index.ts",
  "backendRouterRootExport": "appRouter",
  "routerFactoryNames": [
    "createTRPCRouter"
  ],
  "callerFactoryNames": [
    "createCallerFactory"
  ],
  "pathAliases": {
    "@/": "src/"
  },
  "ignoreProcedures": [
    {
      "path": "admin.createTrustedOAuthClient",
      "reason": "Admin REST endpoint (POST /api/external/admin/oauth/client) run by hand to register OAuth clients such as the Android app; it has no in-repo caller by design."
    }
  ],
  "manualUsages": [],
  "ignoreUsagePaths": [],
  "usageRoots": [
    "src",
    "../android/app/src"
  ],
  "openApiBasePath": "/api/external",
  "openApiTextUsageRoots": [
    "../android/app/src"
  ],
  "reportJsonPath": "reports/trpc-procedure-usage.json",
  "reportMarkdownPath": "reports/trpc-procedure-usage.md"
}
