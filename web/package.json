{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "pnpm dlx @better-auth/cli generate --output src/db/auth-schema.ts -y",
    "build": "next build --turbopack",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run format:check && pnpm run unused",
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:migrate": "TZ=UTC drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "dev": "TZ=UTC next dev --turbopack",
    "duplicate:check": "jscpd ./src --pattern \"**/*.{ts,tsx}\"",
    "email:dev": "email dev --dir src/emails --port 3001",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,mjs,cjs}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,mjs,cjs}\"",
    "lint": "next typegen && NODE_OPTIONS=--max-old-space-size=8192 eslint --max-warnings=0 .",
    "start": "TZ=UTC next start",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "unused": "tsx ./scripts/run-unused.ts",
    "unused:fix": "knip --fix --fix-type exports,types --format",
    "unused:trpc": "tsx ./scripts/check-trpc-procedure-usage.ts",
    "update:apply": "npm-check-updates -u --reject recharts,html-to-image",
    "update:check": "npm-check-updates --errorLevel 2 --reject recharts,html-to-image"
  },
  "dependencies": {
